# ============================================================
# 复制本文件为 .env 后填写真实值（.env 勿提交 Git）
# cp .env.example .env   或在 Windows: copy .env.example .env
# ============================================================

# ---------- 硅基流动（Dify 模型供应商 / 本地脚本直连，与控制台 LLM 一致） ----------
OPENAI_API_KEY=sk-你的硅基流动Key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-14B-Instruct

# ---------- 云端 Dify API（Python 项目必填） ----------
# 固定为云端地址，不要改
DIFY_BASE_URL=https://api.dify.ai/v1

# 工作室 → 通信运维答疑智能体 → 访问 API → API 密钥（app- 开头）
DIFY_APP_API_KEY=app-xxxxxxxxxxxxxxxx

# 知识库 → 移动运维知识库 → 服务 API → API 密钥（dataset- 开头）
DIFY_DATASET_API_KEY=dataset-xxxxxxxxxxxxxxxx

# 知识库 Dataset ID（UUID，见下方说明获取）
DIFY_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------- 本地 MySQL（跑 init.sql 后填写） ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码
MYSQL_DATABASE=dify_ops

# ---------- 可选：Flask 自测页后端 ----------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
